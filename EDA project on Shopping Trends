        "# Exploratory Data Analysis begins:\n",
        "df.groupby(\"Review Rating\")[\"Purchase Amount (USD)\"].sum().head(10).plot(kind = \"bar\", color = \"Red\") # Graph showing how Purchase Amount increases with better reviews\n",
        "plt.title(\"Purchase Amount in relation to Review Rating\") # Graph title\n",
        "plt.xlabel(\"Purchase Amount\") # X label\n",
        "plt.ylabel(\"Review Rating\") # Y label\n",
        "plt.show()\n",
        "\n",
        "df[\"Shipping Type\"].value_counts().plot(kind = \"bar\", color = \"skyblue\") # bar chart showing most frequent shipping types\n",
        "plt.xlabel(\"Shipping Type\") # X label\n",
        "plt.ylabel(\"Frequency\") # Y label\n",
        "plt.title(\"Most used Shipping Types\") # Graph title\n",
        "plt.show()\n",
        "\n",
        "df[\"Gender\"].value_counts().plot(kind = \"bar\", color = \"Pink\") # Bar chart showing Gender Frequency\n",
        "plt.xlabel(\"Gender\") # X label\n",
        "plt.ylabel(\"Frequency\") # Y label\n",
        "plt.title(\"Gender Distribution\") # Graph title\n",
        "plt.show()\n",
        "\n",
        "df[\"Payment Method\"].value_counts().plot(kind = \"bar\", color= \"Green\",)# Bar chart showing most frequent payment methods\n",
        "plt.xlabel(\"Payment Method\") # X label\n",
        "plt.ylabel(\"Frequency\") # Y label\n",
        "plt.title(\"Payment Method distribution\") # Graph title\n",
        "plt.show()\n",
        "\n",
        "df[\"Category\"].value_counts().plot(kind = \"line\", color = \"Blue\", marker= \".\", markersize= \"15\" )# Line chart showing most frequent Categories for orders\n",
        "plt.ylabel(\"Frequency\") # Y label\n",
        "plt.xlabel(\"Item Category\") # X label\n",
        "plt.title(\"Most Frequent Category Ordered\") # Graph title\n",
        "plt.show()\n",
        "\n",
        "df[\"Subscription Status\"].value_counts().plot(kind = \"barh\", color=\"Orange\")# Bar chart showing if order was done with or without Subscription\n",
        "plt.title(\"How many orders were placed with a Subscription\") # Graph title\n",
        "plt.xlabel(\"Frequency\") # X label\n",
        "plt.ylabel(\"Subscription Status\") # Y label\n",
